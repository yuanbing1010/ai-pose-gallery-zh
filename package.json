{
  "name": "ai-pose-gallery-zh",
  "private": true,
  "version": "2.0.0",
  "type": "module",
  "scripts": {
    "dev": "node scripts/dev-all.mjs",
    "dev:web": "vite",
    "dev:worker": "wrangler dev --port 8787 --local",
    "dev:all": "node scripts/dev-all.mjs",
    "db:migrate:local": "wrangler d1 migrations apply ai-pose-gallery-db --local",
    "db:migrate:remote": "wrangler d1 migrations apply ai-pose-gallery-db --remote",
    "build": "tsc -b && vite build",
    "build:dist": "node scripts/build-dist.mjs",
    "deploy": "node scripts/build-dist.mjs && wrangler deploy",
    "sync:mio": "python scripts/import_mio.py --sync",
    "sync:outfit-db": "python scripts/import_outfit_db.py --sync",
    "sync:external": "python scripts/import_mio.py --sync && python scripts/import_outfit_db.py --sync",
    "lint": "oxlint",
    "impeccable": "impeccable detect src/",
    "qa:scroll": "node scripts/scrollshot.mjs",
    "preview": "vite preview"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@fontsource-variable/hanken-grotesk": "^5.3.0",
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "@tailwindcss/vite": "^4.3.3",
    "@tanstack/react-query": "^5.105.0",
    "@tanstack/react-router": "^1.170.46",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "hono": "^4.13.18",
    "lucide-react": "^1.63.0",
    "motion": "^14.12.0",
    "radix-ui": "^1.8.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-resizable-panels": "^4.21.0",
    "recharts": "3.8.0",
    "shadcn": "^4.23.0",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.7.0",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "^1.4.0",
    "zustand": "^5.1.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261114.1",
    "@tanstack/router-plugin": "^1.168.48",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "impeccable": "^4.8.2",
    "oxlint": "^1.89.0",
    "typescript": "~7.0.2",
    "vite": "^8.3.5",
    "wrangler": "^4.162.0"
  }
}
