{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "ai-pose-gallery-zh",
  "main": "worker.ts",
  "compatibility_date": "2025-10-01",
  "observability": {
    "enabled": true
  },
  "previews": {},
  // 部署前请先运行 `npx wrangler d1 create ai-pose-gallery-db` 与 `npx wrangler r2 bucket create ai-pose-gallery-bucket`
  // 并把返回的 database_id 填入下方 d1_databases[0].database_id，再通过 `wrangler secret put APP_ENCRYPTION_KEY` 设置加密密钥
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "ai-pose-gallery-db",
      "database_id": "a98bb0b0-b534-4e03-be71-294a9bfd0685",
      "migrations_dir": "migrations"
    }
  ],
  "r2_buckets": [
    {
      "binding": "BUCKET",
      "bucket_name": "ai-pose-gallery-bucket"
    }
  ],
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  }
}
